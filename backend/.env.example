# ===========================================
# Exyst Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# --- LLM Provider (Google AI Studio / Gemini) ---

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash

# --- Database ---
# Needs the pgvector extension (RAG vectors live in `vector_chunks`).
# Locally: use the pgvector/pgvector:pg16 image, or `brew install pgvector`.
DATABASE_URL=postgresql+asyncpg://exyst:exyst_password@localhost:5432/exyst_db

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_NAME=Exyst
APP_VERSION=2.0.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Email (password reset) ---
# Without a key, reset emails are NOT sent — the link is logged instead
# (fine for local dev; a misconfiguration in production).
RESEND_API_KEY=
EMAIL_FROM=Exyst <onboarding@resend.dev>
# Public URL of the frontend — used to build links in emails.
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=60

# --- File Storage ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
# Set (by Vercel Blob) to store uploads in object storage instead of local
# disk. Required on serverless — /tmp does not survive between invocations.
# BLOB_READ_WRITE_TOKEN=

# --- LLM tuning (optional) ---
LLM_TIMEOUT_SECONDS=90
# An analysis stuck PROCESSING beyond this is reported FAILED so clients
# stop polling (serverless background tasks can be killed mid-run).
ANALYSIS_TIMEOUT_SECONDS=600
